{
  "name": "safari-opencode-extension",
  "version": "1.0.0",
  "description": "Safari extension enabling AI agents to interact with web content through secure credential impersonation and educational content processing",
  "main": "src/background.js",
  "author": "OpenCode Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode/safari-opencode-extension.git"
  },
  "keywords": [
    "safari-extension",
    "ai-agents",
    "llm-integration",
    "educational-content",
    "mcp-protocol",
    "credential-impersonation",
    "form-automation",
    "video-transcription"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "build:js": "webpack --mode production --progress",
    "build:dev": "webpack --mode development",
    "dev": "webpack --mode development --watch --progress",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:accounts": "./scripts/test-accounts.sh",
    "lint": "eslint src/ --ext .js,.ts --fix",
    "lint:check": "eslint src/ --ext .js,.ts",
    "lint:md": "markdownlint *.md docs/*.md",
    "clean": "rm -rf build/ dist/ coverage/",
    "validate": "npm run lint:check && npm run test && npm run build",
    "precommit": "npm run validate"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "markdownlint-cli": "^0.37.0",
    "@types/chrome": "^0.0.251",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.2",
    "ts-loader": "^9.5.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@anthropic-ai/claude-code": "^1.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.test.{js,ts}",
      "!src/popup/popup.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": ["standard"],
    "env": {
      "browser": true,
      "webextensions": true,
      "jest": true
    },
    "rules": {
      "no-console": "warn",
      "prefer-const": "error"
    }
  }
}